# Copy to .env for local development.
# Local database: run `pnpm db:dev` first, then use the printed URL.

DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Production credentials do NOT go here. They live in `.env.production.local`
# (gitignored) and are used only by the `pnpm db:*:prod` scripts — see that file
# for the template. Never put a production URL in `.env`.
