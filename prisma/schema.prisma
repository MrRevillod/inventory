// Prisma schema for the inventory nail-salon POS.
// Datasource URL lives in prisma.config.ts (Prisma ORM v7).
// Auth tables (Better Auth) will be added in a later phase.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/shared/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String        @id @default(uuid())
  name          String
  icon          String        @default("sparkles")
  position      Int           @default(0)
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
}

model Subcategory {
  id         String    @id @default(uuid())
  name       String
  icon       String    @default("sparkles")
  tone       Int       @default(0)
  position   Int       @default(0)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([categoryId])
}

model Product {
  id            String      @id @default(uuid())
  name          String
  price         Int // Chilean pesos, integer, no decimals
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?

  @@index([subcategoryId])
}

model Sale {
  id        String     @id @default(uuid())
  total     Int // Chilean pesos, sum of item price * quantity
  createdAt DateTime   @default(now())
  items     SaleItem[]

  @@index([createdAt])
}

// Name and price are snapshotted so history stays correct even if the
// product is later renamed, re-priced or deleted.
model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  productId String?
  name      String
  price     Int
  quantity  Int
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

// Single-row gate config holding the temporary global PIN. Only a scrypt hash
// and its salt are stored — never the plaintext. Managed with `pnpm pin:set`.
// This is a stopgap; real auth (Better Auth) comes later.
model AppConfig {
  id        String    @id @default("app")
  pinHash   String
  pinSalt   String
  attempts  Int       @default(0)
  lockedAt  DateTime?
  updatedAt DateTime  @updatedAt
}
