{
	"name": "inventory",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "prisma generate && vite dev",
		"build": "prisma generate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && prisma generate && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && prisma generate && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"pwa:assets": "pwa-assets-generator",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"db:dev": "prisma dev",
		"db:stop": "prisma dev stop default",
		"db:deploy:prod": "dotenv run --file .env.production.local -- prisma migrate deploy",
		"db:seed:prod": "dotenv run --file .env.production.local -- prisma db seed",
		"db:studio:prod": "dotenv run --file .env.production.local -- prisma studio"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/pg": "^8.23.1",
		"@vite-pwa/assets-generator": "^2.0.0",
		"dotenv": "^18.0.8",
		"dotenv-cli": "^11.0.0",
		"prisma": "^7.10.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.10.0",
		"@lucide/svelte": "^1.57.0",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	}
}
