{
	"file_types": {
		"Plain Text": ["pnpm-lock.yaml", "*-lock.yaml"]
	},
	"file_scan_exclusions": [
		"**/node_modules/**",
		"**/.git/**",
		"**/routeTree.gen.ts",
		"**/dist/**",
		"**/build/**",
		"**/.pnpm-store"
	],
	"format_on_save": "on",
	"languages": {
		"JavaScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"tab_size": 4,
			"hard_tabs": true,
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"tab_size": 4,
			"hard_tabs": true,
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"formatter": { "language_server": { "name": "biome" } },
			"tab_size": 4,
			"hard_tabs": true,
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"Svelte": {
			"formatter": { "language_server": { "name": "biome" } },
			"tab_size": 4,
			"hard_tabs": true,
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSON": {
			"formatter": { "language_server": { "name": "biome" } },
			"tab_size": 4,
			"hard_tabs": true
		},
		"JSONC": {
			"formatter": { "language_server": { "name": "biome" } },
			"tab_size": 4,
			"hard_tabs": true
		},
		"CSS": {
			"formatter": { "language_server": { "name": "biome" } },
			"tab_size": 4,
			"hard_tabs": true
		},
		"HTML": {
			"formatter": { "language_server": { "name": "biome" } },
			"tab_size": 4,
			"hard_tabs": true
		}
	},
	"lsp": { "biome": { "settings": { "require_config_file": true } } }
}
